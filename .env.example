# Google Maps JavaScript API key for the Radar Map's interactive pins.
# This is a PUBLIC/browser-exposed key -- create a separate one from
# GOOGLE_PLACES_API_KEY (which is server-only) and restrict it in Google
# Cloud Console to: Application restriction = HTTP referrers, limited to
# your site's domain(s); API restriction = Maps JavaScript API only.
# Without this set, the Radar Map falls back to a basic embed with no
# restaurant pins.
VITE_GOOGLE_MAPS_API_KEY=
